{
  "name": "dsh-ink-splash",
  "version": "0.3.8",
  "description": "水墨开屏动画与配套主题：一条墨锋同时描绘 DeepSeek 字标和背景山水，夜山 / 宣纸两套皮肤，字标 / 运笔 / 画面三轴可在设置子页自由搭配。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/inject.mjs",
    "lib/range.mjs",
    "lib/theme.js",
    "lib/prelude.js",
    "lib/ink.css",
    "lib/ink-ui.css",
    "cordis.patch.yml",
    "assets",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "icon": "./assets/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaobaga281/dsh-ink-splash.git"
  },
  "homepage": "https://github.com/xiaobaga281/dsh-ink-splash#readme",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "splash",
    "ink",
    "animation"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
