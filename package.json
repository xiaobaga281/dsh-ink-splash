{
  "name": "dsh-ink-splash",
  "version": "0.4.2",
  "description": "水墨开屏动画与配套主题：四段十秒成片（侠客/鲸娘 × 夜山/宣纸），保留原片背景音；设置只选画面、主题与壁纸亮度。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/inject.mjs",
    "lib/range.mjs",
    "lib/theme.js",
    "lib/prelude.js",
    "lib/ink.css",
    "lib/ink-ui.css",
    "cordis.patch.yml",
    "assets",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "icon": "./assets/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaobaga281/dsh-ink-splash.git"
  },
  "homepage": "https://github.com/xiaobaga281/dsh-ink-splash#readme",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "splash",
    "ink",
    "animation"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
